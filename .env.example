# PostgreSQL w prywatnej sieci Coolify. Nie publikuj portu 5432.
DATABASE_URL=postgresql://portal:ZMIEN_TO@postgresql:5432/portal?schema=public

# Opcjonalny cache publicznego licznika. Bez niego portal korzysta wprost z PostgreSQL.
REDIS_URL=redis://redis:6379/0

# Publiczny adres portalu, bez koncowego ukosnika.
AUTH_URL=https://portal.fundacjalepszydomlepszejutro.pl
NEXT_PUBLIC_PORTAL_URL=https://portal.fundacjalepszydomlepszejutro.pl

# Wygeneruj osobno dla produkcji: openssl rand -base64 48
AUTH_SECRET=ZMIEN_TO_NA_LOSOWY_SEKRET

# Osobny sekret do zadan harmonogramu. Wygeneruj jak AUTH_SECRET.
CRON_SECRET=ZMIEN_TO_NA_INNY_LOSOWY_SEKRET

# Serwer pocztowy uzywany do jednorazowych linkow logowania.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=portal@example.com
SMTP_PASS=ZMIEN_TO
SMTP_FROM=Fundacja Lepszy Dom Lepsze Jutro <portal@example.com>

# Dla serwera 6 vCPU rekomendowane są 3 procesy aplikacji.
WEB_CONCURRENCY=3
