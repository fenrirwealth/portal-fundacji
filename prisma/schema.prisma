// ============================================================
//  Fundacja Lepszy Dom Lepsze Jutro — schemat bazy danych
//  PostgreSQL + Prisma
//
//  Modele dziedzinowe po polsku, modele wymagane przez Auth.js po
//  angielsku (User, Account, Session, VerificationToken). Adapter
//  wymaga dokladnie tych nazw — tlumaczenie ich konczy sie walka
//  z biblioteka.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
//  TOZSAMOSC
//
//  Jedno konto = jeden adres e-mail. Niezaleznie od tego, czy
//  uzytkownik zaloguje sie linkiem, czy w przyszlosci przez Google,
//  trafia na to samo konto — kluczem jest zweryfikowany adres,
//  a nie dostawca logowania.
//
//  Administrator i darczynca uzywaja tego samego logowania.
//  Rozdziela ich wylacznie rola w bazie.
// ------------------------------------------------------------

enum Rola {
  DARCZYNCA
  REDAKCJA
  ZARZAD
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?

  telefon             String?
  telefonPotwierdzony DateTime?
  rola                Rola      @default(DARCZYNCA)

  // Zgody zapisujemy dopiero po faktycznym zaznaczeniu pola, nigdy
  // domyslnie. Przechowujemy tez wersje tresci — bez niej nie da sie
  // wykazac, na co uzytkownik sie zgodzil.
  zgodaRegulamin       DateTime?
  wersjaRegulaminu     String?
  zgodaMarketing       DateTime?
  wersjaZgodyMarketing String?

  accounts    Account[]
  sessions    Session[]
  rezerwacje  Rezerwacja[]
  weryfikacje Weryfikacja[]

  utworzony      DateTime @default(now())
  zaktualizowany DateTime @updatedAt

  @@index([email])
}

// Modele wymagane przez Auth.js. Nie zmieniac nazw pol.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ------------------------------------------------------------
//  EDYCJE AKCJI
//
//  Bez tego listy z 2026 i 2027 wpadlyby do jednej puli, a licznik
//  i filtry zaczelyby mieszac lata.
// ------------------------------------------------------------

model EdycjaAkcji {
  id                 String   @id @default(cuid())
  rok                Int      @unique
  nazwa              String
  dataStart          DateTime
  dataKoniec         DateTime
  terminDostarczenia DateTime
  aktywna            Boolean  @default(false)

  listy   List[]
  udzialy UdzialPlacowki[]

  utworzona DateTime @default(now())

  @@index([aktywna])
}

// ------------------------------------------------------------
//  PLACOWKI
//
//  Placowka jest rekordem stalym — instytucja, ktora moze wracac
//  co roku. Jej status w konkretnej akcji to osobny rekord udzialu.
//  Placowki NIE MAJA kont w portalu: zglaszaja udzial formularzem,
//  a materialy przekazuja poza systemem.
// ------------------------------------------------------------

model Placowka {
  id          String  @id @default(cuid())
  nazwa       String
  ulica       String?
  kodPocztowy String?
  miejscowosc String?
  wojewodztwo String

  osobaKontaktowa String?
  email           String?
  telefon         String?
  notatki         String?

  listy            List[]
  udzialyWEdycjach UdzialPlacowki[]
  dostawy          Dostawa[]

  utworzona      DateTime @default(now())
  zaktualizowana DateTime @updatedAt

  @@index([wojewodztwo])
}

enum StatusUdzialu {
  ZGLOSZONA
  POTWIERDZILA
  ODMOWILA
  ZAKONCZONA
}

model UdzialPlacowki {
  id         String      @id @default(cuid())
  placowkaId String
  placowka   Placowka    @relation(fields: [placowkaId], references: [id], onDelete: Cascade)
  edycjaId   String
  edycja     EdycjaAkcji @relation(fields: [edycjaId], references: [id], onDelete: Cascade)

  status             StatusUdzialu @default(ZGLOSZONA)
  deklarowaneDzieci  Int?
  zakazanePrzedmioty String?
  uwagi              String?

  utworzony      DateTime @default(now())
  zaktualizowany DateTime @updatedAt

  @@unique([placowkaId, edycjaId])
  @@index([status])
}

// ------------------------------------------------------------
//  LISTY
//
//  Listy tworzy WYLACZNIE administrator (rola REDAKCJA lub ZARZAD).
//  Kazdy zaczyna jako SZKIC i wymaga swiadomej publikacji.
// ------------------------------------------------------------

enum StatusListu {
  SZKIC
  DO_POPRAWY
  OPUBLIKOWANY
  ZAREZERWOWANY
  OPLACONY
  PRZEKAZANY
  WYCOFANY
}

enum Kategoria {
  ZABAWKI
  SPORT
  KSIAZKI
  NAUKA
  UBRANIA
  INNE
}

model List {
  id    String @id @default(cuid())
  numer Int    @unique @default(autoincrement())

  edycjaId String
  edycja   EdycjaAkcji @relation(fields: [edycjaId], references: [id])

  // --- dane publiczne ---
  imie        String
  wiek        Int
  wojewodztwo String
  kategoria   Kategoria
  marzenie    String
  rozmiar     String?

  // Opis pisze administrator. To nie jest transkrypcja listu.
  opis String?

  // JEDNO pole, swiadomie. Oryginalu skanu nie przechowujemy w portalu
  // w ogole: zdjecie przygotowuje i sprawdza administrator przed
  // wgraniem. Czego nie ma, tego nie da sie wyciec.
  zdjecieUrl String?

  // --- dane wewnetrzne ---
  placowkaId String
  placowka   Placowka @relation(fields: [placowkaId], references: [id])

  // Podpisana zgoda dyrektora zostaje w dokumentacji fundacji, NIE
  // w portalu. To najbardziej wrazliwy dokument w calej akcji: podpis,
  // imie dziecka, nazwa placowki. W bazie odnotowujemy wylacznie fakt
  // jej otrzymania i osobe, ktora to potwierdzila.
  zgodaData      DateTime?
  zgodaPrzyjalId String?
  zgodaCofnieta  DateTime?

  status StatusListu @default(SZKIC)

  rezerwacje  Rezerwacja[]
  weryfikacja Weryfikacja?

  utworzony      DateTime @default(now())
  zaktualizowany DateTime @updatedAt

  @@index([status])
  @@index([edycjaId, status])
  @@index([kategoria, wiek])
}

model Weryfikacja {
  id      String @id @default(cuid())
  listId  String @unique
  list    List   @relation(fields: [listId], references: [id], onDelete: Cascade)
  osobaId String
  osoba   User   @relation(fields: [osobaId], references: [id])

  zgodaDolaczona       Boolean @default(false)
  brakNazwiska         Boolean @default(false)
  brakPlacowki         Boolean @default(false)
  brakMiejscowosci     Boolean @default(false)
  brakInnychOsob       Boolean @default(false)
  brakDanychWrazliwych Boolean @default(false)
  brakWizerunku        Boolean @default(false)
  metadaneUsuniete     Boolean @default(false)
  nazwaPlikuPoprawna   Boolean @default(false)
  opisPoprawny         Boolean @default(false)

  uwagi      String?
  zakonczona DateTime?
  utworzona  DateTime @default(now())
}

// ------------------------------------------------------------
//  REZERWACJE
//
//  Limit "jedno konto — jeden aktywny list" wymusza CZESCIOWY INDEKS
//  UNIKALNY dopisany w migracji recznie. Sprawdzanie tego w kodzie
//  przed transakcja przepuszcza dwa rownolegle zadania; baza nie
//  przepusci nigdy.
// ------------------------------------------------------------

enum StatusRezerwacji {
  OCZEKUJE
  POTWIERDZONA
  DOSTARCZONA
  WYGASLA
  ANULOWANA
}

model Rezerwacja {
  id     String @id @default(cuid())
  listId String
  list   List   @relation(fields: [listId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [id])

  status               StatusRezerwacji @default(OCZEKUJE)
  wygasa               DateTime
  potwierdzona         DateTime?
  anulowana            DateTime?
  przypomnienieWyslane DateTime?

  prezent   Prezent?
  utworzona DateTime @default(now())

  @@index([status, wygasa])
  @@index([userId])
}

enum StanPrezentu {
  ZAPOWIEDZIANY
  PRZYJETY
  SPRAWDZONY
  ODRZUCONY
  ZAPAKOWANY
  WYDANY
}

model Prezent {
  id           String     @id @default(cuid())
  rezerwacjaId String     @unique
  rezerwacja   Rezerwacja @relation(fields: [rezerwacjaId], references: [id], onDelete: Cascade)

  stan            StanPrezentu @default(ZAPOWIEDZIANY)
  dataPrzyjecia   DateTime?
  przyjetyPrzez   String?
  opisZawartosci  String?
  powodOdrzucenia String?

  dostawaId String?
  dostawa   Dostawa? @relation(fields: [dostawaId], references: [id])

  utworzony      DateTime @default(now())
  zaktualizowany DateTime @updatedAt
}

model Dostawa {
  id           String    @id @default(cuid())
  placowkaId   String
  placowka     Placowka  @relation(fields: [placowkaId], references: [id])
  dataWydania  DateTime?
  odebralOsoba String?
  protokolPlik String?

  prezenty  Prezent[]
  utworzona DateTime @default(now())
}

model Aktualnosc {
  id           String    @id @default(cuid())
  slug         String    @unique
  tytul        String
  zajawka      String
  tresc        String
  obrazUrl     String?
  opublikowana DateTime?

  utworzona      DateTime @default(now())
  zaktualizowana DateTime @updatedAt

  @@index([opublikowana])
}

enum StatusZgloszenia {
  NOWE
  W_TOKU
  PRZYJETE
  ODRZUCONE
}

model ZgloszeniePotrzeby {
  id             String  @id @default(cuid())
  ktoZglasza     String
  nazwa          String
  miejscowosc    String?
  rodzajPotrzeby String
  opis           String
  kontakt        String

  status  StatusZgloszenia @default(NOWE)
  notatki String?

  utworzone      DateTime @default(now())
  zaktualizowane DateTime @updatedAt

  @@index([status])
}
