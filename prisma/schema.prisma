// ============================================================
//  Fundacja Lepszy Dom Lepsze Jutro — schemat bazy danych
//  PostgreSQL + Prisma
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rola {
  DARCZYNCA
  REDAKCJA
  ZARZAD
}

model Uzytkownik {
  id            String   @id @default(cuid())
  email         String   @unique
  imieNazwisko  String
  telefon       String?
  telefonPotwierdzony DateTime?
  rola          Rola     @default(DARCZYNCA)

  // Logowanie przez Google/Facebook. Hasla nie przechowujemy w ogole —
  // nie ma czego wykrasc i nie ma czego resetowac w grudniu.
  dostawcaAuth  String?
  idZewnetrzne  String?

  emailPotwierdzony DateTime?
  zgodaRegulamin    DateTime @default(now())
  zgodaMarketing    DateTime?

  rezerwacje    Rezerwacja[]
  weryfikacje   Weryfikacja[]

  utworzony     DateTime @default(now())
  zaktualizowany DateTime @updatedAt

  @@index([email])
  @@unique([dostawcaAuth, idZewnetrzne])
}

// Przelaczniki zmieniane z panelu, bez wdrazania nowej wersji.
model Ustawienie {
  klucz     String   @id
  wartosc   String
  opis      String?
  zmienione DateTime @updatedAt
}

enum StatusPlacowki {
  ZGLOSZONA
  POTWIERDZILA
  ODMOWILA
  ZAKONCZONA
}

// Dane wrazliwe. Widoczne wylacznie dla roli ZARZAD.
model Placowka {
  id              String   @id @default(cuid())
  nazwa           String
  ulica           String?
  kodPocztowy     String?
  miejscowosc     String?
  wojewodztwo     String

  osobaKontaktowa String?
  email           String?
  telefon         String?

  status          StatusPlacowki @default(ZGLOSZONA)
  zakazanePrzedmioty String?
  notatki         String?

  listy           List[]
  dostawy         Dostawa[]

  utworzona       DateTime @default(now())
  zaktualizowana  DateTime @updatedAt
}

enum StatusListu {
  SZKIC
  DO_POPRAWY
  OPUBLIKOWANY
  ZAREZERWOWANY
  OPLACONY
  PRZEKAZANY
  WYCOFANY
}

enum Kategoria {
  ZABAWKI
  SPORT
  KSIAZKI
  NAUKA
  UBRANIA
  INNE
}

model List {
  id           String   @id @default(cuid())
  numer        Int      @unique @default(autoincrement())

  // --- dane publiczne ---
  imie         String
  wiek         Int
  wojewodztwo  String
  kategoria    Kategoria
  marzenie     String
  rozmiar      String?
  skanUrl      String?
  trescOdczytana String?

  // --- dane wewnetrzne ---
  placowkaId   String
  placowka     Placowka @relation(fields: [placowkaId], references: [id])
  zgodaPlik    String?
  zgodaData    DateTime?
  zgodaCofnieta DateTime?

  status       StatusListu @default(SZKIC)

  rezerwacje   Rezerwacja[]
  weryfikacje  Weryfikacja[]

  utworzony    DateTime @default(now())
  zaktualizowany DateTime @updatedAt

  @@index([status])
  @@index([kategoria, wiek])
}

// Odpowiednik papierowej karty weryfikacji. List nie moze zostac
// opublikowany, dopoki wszystkie pozycje nie sa odhaczone.
model Weryfikacja {
  id                 String  @id @default(cuid())
  listId             String  @unique
  list               List    @relation(fields: [listId], references: [id])
  osobaId            String
  osoba              Uzytkownik @relation(fields: [osobaId], references: [id])

  zgodaDolaczona     Boolean @default(false)
  brakNazwiska       Boolean @default(false)
  brakPlacowki       Boolean @default(false)
  brakMiejscowosci   Boolean @default(false)
  brakInnychOsob     Boolean @default(false)
  brakDanychWrazliwych Boolean @default(false)
  brakWizerunku      Boolean @default(false)
  metadaneUsuniete   Boolean @default(false)
  nazwaPlikuPoprawna Boolean @default(false)
  opisPoprawny       Boolean @default(false)

  uwagi              String?
  zakonczona         DateTime?
  utworzona          DateTime @default(now())
}

enum StatusRezerwacji {
  OCZEKUJE
  POTWIERDZONA
  DOSTARCZONA
  WYGASLA
  ANULOWANA
}

model Rezerwacja {
  id            String   @id @default(cuid())
  listId        String
  list          List     @relation(fields: [listId], references: [id])
  uzytkownikId  String
  uzytkownik    Uzytkownik @relation(fields: [uzytkownikId], references: [id])

  status        StatusRezerwacji @default(OCZEKUJE)
  wygasa        DateTime
  potwierdzona  DateTime?
  anulowana     DateTime?
  przypomnienieWyslane DateTime?

  prezent       Prezent?
  utworzona     DateTime @default(now())

  @@index([status, wygasa])
  @@index([uzytkownikId])
}

enum StanPrezentu {
  ZAPOWIEDZIANY
  PRZYJETY
  SPRAWDZONY
  ODRZUCONY
  ZAPAKOWANY
  WYDANY
}

model Prezent {
  id             String   @id @default(cuid())
  rezerwacjaId   String   @unique
  rezerwacja     Rezerwacja @relation(fields: [rezerwacjaId], references: [id])

  stan           StanPrezentu @default(ZAPOWIEDZIANY)
  dataPrzyjecia  DateTime?
  przyjetyPrzez  String?
  opisZawartosci String?
  powodOdrzucenia String?

  dostawaId      String?
  dostawa        Dostawa? @relation(fields: [dostawaId], references: [id])

  utworzony      DateTime @default(now())
  zaktualizowany DateTime @updatedAt
}

model Dostawa {
  id           String   @id @default(cuid())
  placowkaId   String
  placowka     Placowka @relation(fields: [placowkaId], references: [id])
  dataWydania  DateTime?
  odebralOsoba String?
  protokolPlik String?

  prezenty     Prezent[]
  utworzona    DateTime @default(now())
}

model Aktualnosc {
  id            String   @id @default(cuid())
  slug          String   @unique
  tytul         String
  zajawka       String
  tresc         String
  obrazUrl      String?
  opublikowana  DateTime?

  utworzona     DateTime @default(now())
  zaktualizowana DateTime @updatedAt

  @@index([opublikowana])
}

enum StatusZgloszenia {
  NOWE
  W_TOKU
  PRZYJETE
  ODRZUCONE
}

model ZgloszeniePotrzeby {
  id            String   @id @default(cuid())
  ktoZglasza    String
  nazwa         String
  miejscowosc   String?
  rodzajPotrzeby String
  opis          String
  kontakt       String

  status        StatusZgloszenia @default(NOWE)
  notatki       String?

  utworzone     DateTime @default(now())
  zaktualizowane DateTime @updatedAt

  @@index([status])
}
